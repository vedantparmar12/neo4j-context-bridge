{
  "mcpServers": {
    "neo4j-lightrag-production": {
      "command": "node",
      "args": ["C:\\Users\\vedan\\Desktop\\mcp-rag\\Neo4j-mcp\\dist\\standalone-server.js"],
      "env": {
        "NEO4J_URI": "neo4j+s://your-neo4j-server.com:7687",
        "NEO4J_USER": "neo4j",
        "NEO4J_PASSWORD": "your-secure-production-password",
        "NEO4J_DATABASE": "neo4j",
        "NEO4J_ENCRYPTED": "true",
        "NEO4J_TRUST": "TRUST_SYSTEM_CA_SIGNED_CERTIFICATES",
        
        "NEO4J_MAX_CONNECTION_LIFETIME": "3600000",
        "NEO4J_MAX_CONNECTION_POOL_SIZE": "50",
        "NEO4J_CONNECTION_ACQUISITION_TIMEOUT": "120000",
        "NEO4J_CONNECTION_TIMEOUT": "30000",
        "NEO4J_MAX_TRANSACTION_RETRY_TIME": "30000",
        
        "MAX_CONTEXT_TOKENS": "4000",
        "MAX_INJECTION_TOKENS": "2000",
        
        "MCP_API_KEY": "your-secure-api-key-here-32-chars-minimum",
        "MCP_API_KEY_REQUIRED": "true",
        "MCP_ALLOWED_ORIGINS": "https://claude.ai,https://app.anthropic.com",
        
        "LOG_LEVEL": "warn",
        "NODE_ENV": "production",
        
        "CACHE_ENABLED": "true",
        "CACHE_TTL": "600000",
        "CACHE_MAX_SIZE": "500",
        
        "RATE_LIMIT_ENABLED": "true",
        "RATE_LIMIT_MAX_REQUESTS": "200",
        "RATE_LIMIT_WINDOW_MS": "60000",
        
        "OLLAMA_BASE_URL": "https://your-ollama-endpoint.com",
        "OLLAMA_MODEL": "llama3.2:latest",
        "OLLAMA_EMBEDDING_MODEL": "nomic-embed-text:latest",
        "OLLAMA_TIMEOUT": "90000",
        
        "LIGHTRAG_ENABLED": "true",
        "LIGHTRAG_AUTO_EXTRACTION": "true",
        "LIGHTRAG_MAX_ENTITIES_PER_EXTRACTION": "75",
        "LIGHTRAG_MAX_RELATIONS_PER_EXTRACTION": "150",
        "LIGHTRAG_EMBEDDING_DIMENSION": "768",
        "LIGHTRAG_SIMILARITY_THRESHOLD": "0.75",
        "LIGHTRAG_MAX_HOPS": "4",
        "LIGHTRAG_MIN_RELATION_STRENGTH": "0.2"
      }
    }
  },
  "globalShortcut": {
    "neo4j-query": {
      "key": "Ctrl+Shift+N",
      "description": "Production Neo4j Light RAG query"
    }
  },
  "security": {
    "requireApiKey": true,
    "allowedHosts": ["claude.ai", "app.anthropic.com"],
    "rateLimiting": true
  }
}