# Neo4j Connection Configuration
NEO4J_URI=neo4j://localhost:7687
# For encrypted connections use: neo4j+s://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-secure-password-here
NEO4J_DATABASE=neo4j

# TLS/SSL Configuration
NEO4J_ENCRYPTED=true
# Options: TRUST_ALL_CERTIFICATES, TRUST_CUSTOM_CA_SIGNED_CERTIFICATES, TRUST_SYSTEM_CA_SIGNED_CERTIFICATES
NEO4J_TRUST=TRUST_SYSTEM_CA_SIGNED_CERTIFICATES
# Optional: Path to custom certificate
# NEO4J_CERT_PATH=/path/to/certificate.pem

# Connection Pool Settings
NEO4J_MAX_CONNECTION_LIFETIME=3600000
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_ACQUISITION_TIMEOUT=120000
NEO4J_CONNECTION_TIMEOUT=30000
NEO4J_MAX_TRANSACTION_RETRY_TIME=30000

# MCP Server Configuration
MAX_CONTEXT_TOKENS=2000
MAX_INJECTION_TOKENS=1000

# API Key Authentication
# Generate a secure API key: openssl rand -hex 32
MCP_API_KEY=
MCP_API_KEY_REQUIRED=false
# Optional: Comma-separated list of allowed origins
# MCP_ALLOWED_ORIGINS=http://localhost:3000,https://app.example.com

# Logging
# Options: error, warn, info, debug
LOG_LEVEL=info

# Environment
# Options: development, production, test
NODE_ENV=production

# Caching
CACHE_ENABLED=true
CACHE_TTL=300000
CACHE_MAX_SIZE=100

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# =============================================================================
# LIGHT RAG CONFIGURATION
# Advanced hybrid retrieval system with dual-level processing and vector search
# =============================================================================

# Ollama Server Configuration
OLLAMA_BASE_URL=http://localhost:11434
# For remote Ollama: http://your-ollama-server:11434
# For cloud deployment: https://your-ollama-endpoint.com

# LLM Models Configuration
OLLAMA_MODEL=llama3.2:latest
# Alternative models: llama2:7b, mistral:7b, codellama:13b, phi3:mini
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
# Alternative: all-minilm:l6-v2, sentence-transformers/all-mpnet-base-v2

# Ollama Connection Settings
OLLAMA_TIMEOUT=60000
# Increase for slower models: 120000 (2 minutes)

# Light RAG Feature Toggles
LIGHTRAG_ENABLED=true
# Set to false to disable Light RAG and use simple graph RAG only

LIGHTRAG_AUTO_EXTRACTION=true
# Automatically extract entities from conversations as they happen

# Entity Extraction Limits
LIGHTRAG_MAX_ENTITIES_PER_EXTRACTION=50
# Maximum entities to extract per conversation batch

LIGHTRAG_MAX_RELATIONS_PER_EXTRACTION=100
# Maximum relationships to extract per conversation batch

# Vector Search Configuration
LIGHTRAG_EMBEDDING_DIMENSION=768
# Must match your embedding model's dimension
# nomic-embed-text: 768, all-minilm-l6-v2: 384

LIGHTRAG_SIMILARITY_THRESHOLD=0.7
# Minimum cosine similarity for vector search results (0.0-1.0)
# Lower = more results, Higher = more precise results

# Graph Analysis Settings
LIGHTRAG_MAX_HOPS=3
# Maximum relationship hops for subgraph analysis
# Higher values = more comprehensive but slower

LIGHTRAG_MIN_RELATION_STRENGTH=0.1
# Minimum strength score for relationships to be stored (0.0-1.0)

# Advanced Light RAG Tuning (Optional)
# LIGHTRAG_BATCH_SIZE=10
# LIGHTRAG_CACHE_EMBEDDINGS=true
# LIGHTRAG_PARALLEL_EXTRACTION=true
# LIGHTRAG_EXTRACTION_PROMPT_TEMPLATE=custom